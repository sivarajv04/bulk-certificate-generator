# SQLite works out of the box. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/certgen
DATABASE_URL=sqlite:///./data/certgen.db
STORAGE_DIR=./data/storage

MAX_RECIPIENTS=1000
MAX_NAME_LENGTH=100
CERTIFICATE_PREFIX=CERT

LOG_LEVEL=INFO
LOG_JSON=false
MAX_IMPORT_FILE_BYTES=5242880
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
